PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/xyz_convent_school
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
QR_TOKEN_TTL=2m
REDIS_URL=redis://127.0.0.1:6379
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false
NODE_ENV=development

SCHOOL_NAME=XYZ Convent School

# ——— Real Gmail via Nodemailer ———
# Create a Google App Password: Google Account → Security → 2FA → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.school@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="XYZ Convent School <your.school@gmail.com>"

# ——— Real WhatsApp (pick ONE) ———
# Option A: Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Option B: Free CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/)
# Activate bot in WhatsApp, then set your phone (with country code) + apikey
WHATSAPP_CALLMEBOT_KEY=
